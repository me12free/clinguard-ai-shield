# Copy to `.env` in this folder if you load it with python-dotenv, or export before uvicorn.
# Most setups: prefix the uvicorn command (see docs/LOGGING_AND_ENGINE.md).

# --- PHI detection pipeline (pick one) ---
# `both` — regex + patient-line + entropy + NER (default; respects USE_ML).
# `regex_only` — rules/heuristics only (no transformer NER).
# `ner_only` — local phi_model / dslim NER only (no regex; needs USE_ML=1).
PHI_DETECTION_MODE=both

# `0` disables NER in `both` mode; required for `ner_only` to return spans.
USE_ML=1

# Optional: override path to trained token classifier (must contain config.json).
# PHI_MODEL_PATH=/path/to/phi_model
