# ClinGuard detection engine. Copy to .env for local overrides.
# Inference (phi_detector.py)
USE_ML=1
PHI_MODEL_PATH=

# RAG (rag_engine.py)
RAG_EMBED_MODEL=all-MiniLM-L6-v2

# Cleanup script (scripts/clean_phi_data.py) – reference
KEEP_LANG=en

# Training (train_phi_model.py) – optional
# PHI_DATA_DIR=data/cleaned
# PHI_MODEL_PATH=./phi_model
# PHI_EPOCHS=2
# PHI_BATCH_SIZE=4
# BASE_MODEL=bert-base-uncased
# TRAIN_SAMPLE=0
# VAL_SAMPLE=0
# PHI_SYNTHETIC_COUNT=2000
# LOAD_BEST_AT_END=0
