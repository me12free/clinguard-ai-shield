# ClinGuard detection engine. Copy to .env for local overrides.
# Inference (phi_detector.py)
USE_ML=1
PHI_MODEL_PATH=

# RAG (rag_engine.py)
RAG_EMBED_MODEL=all-MiniLM-L6-v2
# Optional but recommended for faster/more reliable Hugging Face downloads.
# Create at https://huggingface.co/settings/tokens and use a read token.
HF_TOKEN=

# Cleanup script (scripts/clean_phi_data.py) – reference
KEEP_LANG=en

# Training (train_phi_model.py) – optional
# PHI_DATA_DIR=data/cleaned
# PHI_MODEL_PATH=./phi_model
# PHI_EPOCHS=2
# PHI_BATCH_SIZE=4
# BASE_MODEL=bert-base-uncased
# TRAIN_SAMPLE=0
# VAL_SAMPLE=0
# PHI_SYNTHETIC_COUNT=2000
# LOAD_BEST_AT_END=0
# Copy to `.env` in this folder if you load it with python-dotenv, or export before uvicorn.
# Most setups: prefix the uvicorn command (see docs/LOGGING_AND_ENGINE.md).

# --- PHI detection pipeline (pick one) ---
# `both` — regex + patient-line + entropy + NER (default; respects USE_ML).
# `regex_only` — rules/heuristics only (no transformer NER).
# `ner_only` — local phi_model / dslim NER only (no regex; needs USE_ML=1).
PHI_DETECTION_MODE=both

# `0` disables NER in `both` mode; required for `ner_only` to return spans.
USE_ML=1

# Optional: override path to trained token classifier (must contain config.json).
# PHI_MODEL_PATH=/path/to/phi_model
