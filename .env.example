# =============================================================================
# ClinGuard frontend (Vite) — copy to `.env` in this directory (repo root)
# =============================================================================
#
# API base URL for all `fetch` calls in `src/lib/api.ts`.
#
# RECOMMENDED (local dev, avoids CORS + hostname mismatch):
#   Leave VITE_API_URL empty. The app uses same-origin paths like `/api/user`.
#   `vite.config.ts` proxies `/api`, `/login`, `/register`, `/sanctum` to Laravel.
#   Set VITE_PROXY_TARGET to match where `php artisan serve` runs.
#
# ALTERNATIVE (direct to Laravel):
#   VITE_API_URL=http://localhost:8000
#   Use the SAME host you use in the browser (do not mix `localhost` and `127.0.0.1`).
#   Laravel must allow CORS for your Vite origin (`FRONTEND_URL` in laravel-backend/.env).
#
# Production:
#   VITE_API_URL=https://api.yourdomain.com

# Empty = use Vite dev proxy (see vite.config.ts)
VITE_API_URL=

# Laravel origin for the dev proxy (only used when VITE_API_URL is empty)
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Vite dev server port (optional)
# VITE_DEV_PORT=8080
