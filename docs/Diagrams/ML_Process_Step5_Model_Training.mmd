%% ML Process Step 5: Model Training
%% Train/val data -> Trainer -> model artifacts. Insights: epoch metrics, path.
%% Render at mermaid.live or VS Code Mermaid extension.

flowchart LR
  subgraph input [Input]
    D1[Train dataset]
    D2[Val dataset]
    D3[Base model: BERT or DistilBERT]
  end

  subgraph training [Training Loop]
    T1[Trainer.train]
    T2[Forward pass, loss]
    T3[Eval on val each epoch]
    T4[Save best or last checkpoint]
  end

  T1 --> T2 --> T3 --> T4

  subgraph outputs [Model Artifacts and Insights]
    O1[config.json]
    O2[Tokenizer files]
    O3[Model weights]
    O4[label_map.json]
    O5[Optional: trainer_state.json\nlog_history, eval metrics]
  end

  D1 --> T1
  D2 --> T1
  D3 --> T1
  T4 --> O1
  T4 --> O2
  T4 --> O3
  T4 --> O4
  T3 --> O5

  style training fill:none,stroke:#333
  style outputs fill:none,stroke:#333
