%% ML Process Step 3: Data Cleaning and Preprocessing
%% Raw -> normalize, filter language, dedup, split -> train/val/test + stats.
%% Render at mermaid.live or VS Code Mermaid extension.

flowchart LR
  Raw[data/raw/*.jsonl]

  subgraph clean [clean_phi_data.py]
    C1[Normalize text and spans]
    C2[Validate categories]
    C3[Filter language\n e.g. English only]
    C4[Deduplicate by text]
    C5[Shuffle and split\n70 / 15 / 15]
  end

  C1 --> C2 --> C3 --> C4 --> C5

  subgraph outputs [Outputs and Insights]
    O1[train.json]
    O2[val.json]
    O3[test.json]
    O4[stats.json\nbefore_count, dropped_*, label_distribution]
  end

  Raw --> C1
  C5 --> O1
  C5 --> O2
  C5 --> O3
  C5 --> O4

  style clean fill:none,stroke:#333
  style outputs fill:none,stroke:#333
